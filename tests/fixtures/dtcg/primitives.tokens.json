{
  "$description": "Base palette (tier 1)",
  "color": {
    "$type": "color",
    "blue": {
      "900": { "$value": { "colorSpace": "oklch", "components": [0.32, 0.09, 262] } },
      "50": { "$value": { "colorSpace": "oklch", "components": [0.97, 0.014, 254] } },
      "100": { "$value": { "colorSpace": "oklch", "components": [0.93, 0.03, 255] } },
      "500": { "$value": { "colorSpace": "oklch", "components": [0.62, 0.19, 259.8] } },
      "700": { "$value": { "colorSpace": "oklch", "components": [0.49, 0.16, 262], "alpha": 1.0 } }
    },
    "red": {
      "100": { "$value": { "colorSpace": "srgb", "components": [1, 0.89, 0.89], "hex": "#ffe2e2" } },
      "500": { "$value": { "colorSpace": "srgb", "components": [0.98, 0.17, 0.21], "hex": "#fb2c36" } },
      "700": { "$value": { "colorSpace": "srgb", "components": [0.76, 0, 0.03], "hex": "#c10007" } }
    },
    "neutral": {
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "1000": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 0.5e1, "unit": "px" }, "$description": "Café spacing" }
  }
}
